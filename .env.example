# --- Required -------------------------------------------------------------

# Postgres connection string (Supabase, Neon, Railway, or local docker-compose)
# Local: postgres://tenpoint:tenpoint@localhost:5432/tenpoint
DATABASE_URL=

# TMDB API key (v3): https://www.themoviedb.org/settings/api
TMDB_API_KEY=


# --- Required in production ------------------------------------------------

# Where the app is reachable. Used to build the links in verification and
# password-reset emails, so a wrong value sends people to the wrong host.
APP_URL=http://localhost:3000


# --- Optional --------------------------------------------------------------

# Resend API key (https://resend.com). Without it, verification and reset
# emails are printed to the server console instead of sent — which is fine
# locally, and is why signup works with no mail configuration at all.
RESEND_API_KEY=

# Sender address for outbound mail. Must be a domain verified with Resend.
MAIL_FROM="Tenpoint <onboarding@resend.dev>"

# Comma-separated usernames allowed to read /admin/reports.
ADMIN_USERNAMES=

# Shown on the privacy and terms pages as the contact address.
CONTACT_EMAIL=

# How many proxies sit in front of the app, i.e. how many trailing
# X-Forwarded-For entries are trustworthy. Defaults to 1 in production
# (Railway forwards once) and 0 in development. Only raise it if you add a CDN
# in front — too high and the rate limiter reads attacker-supplied addresses.
# TRUSTED_PROXY_HOPS=1

# Set to "production" by the host. This is what flips the session cookie to
# `secure`, so it is not optional in a real deployment.
# NODE_ENV=production

# OMDb API key — free tier at omdbapi.com. Optional: without it,
# external scores are simply absent.
OMDB_API_KEY=
